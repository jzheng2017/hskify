{
  "workspaces": [
    "ui/",
    "extensions/firefox/"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts tauri dev -- --profile=release-with-debug",
    "build": "bun run scripts/dev.ts tauri build --no-bundle",
    "cargo": "bun run scripts/dev.ts cargo",
    "dev:firefox": ".\\dev-firefox.cmd",
    "build:firefox": "bun run --filter @hskify/firefox build",
    "test:firefox": "bun run --filter @hskify/firefox test",
    "test:real-reader:manifest": "node scripts/real-reader-corpus.mjs manifest",
    "test:real-reader:smoke": "node scripts/run-real-reader-regression.mjs --selection smoke",
    "test:real-reader:core": "node scripts/run-real-reader-regression.mjs --selection core",
    "test:real-reader:all": "node scripts/run-real-reader-regression.mjs --selection all",
    "test:structural-gates": "node scripts/benchmark/structural-gate-self-tests.mjs",
    "test:chapter-benchmark-gates": "node --test scripts/benchmark/document-chapter-gates.test.mjs scripts/run-document-chapter-benchmark.test.mjs scripts/run-image-runtime-benchmark.test.mjs",
    "benchmark:document": "node scripts/run-document-chapter-benchmark.mjs",
    "benchmark:document:gates": "node scripts/benchmark/document-chapter-gates.mjs .cache/document-chapter-benchmark/raw-samples.json",
    "benchmark:image": "node scripts/run-image-runtime-benchmark.mjs",
    "benchmark:image:gates": "node scripts/benchmark/image-runtime-gates.mjs .cache/image-runtime-benchmark/raw-samples.json",
    "typecheck:firefox": "bun run --filter @hskify/firefox typecheck",
    "lint:ui": "bun run --filter ui lint",
    "test:ui": "bun run --filter ui test",
    "format": "oxfmt ui package.json .oxfmtrc.json .vscode",
    "format:check": "oxfmt --check ui package.json .oxfmtrc.json .vscode",
    "generate:openapi": "cargo run -p koharu-rpc --bin openapi -- ui/openapi.json",
    "generate:client": "openapi-generator-cli generate -i ui/openapi.json -g rust -o tests/integration-tests/client --package-name koharu-client --additional-properties=library=reqwest,supportAsync=true,preferUnsignedInt=true,packageVersion=0.0.0",
    "test:redesign:firefox": "node scripts/test-redesign-firefox.mjs",
    "test:redesign:gates": "node --test scripts/benchmark/generalization-gates.test.mjs"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.39.0",
    "@tauri-apps/cli": "^2.11.3",
    "git-cliff": "^2.13.1",
    "oxfmt": "^0.56.0"
  }
}
