{
  "name": "@hskify/firefox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "build": "wxt build -b firefox",
    "zip": "wxt zip -b firefox",
    "prepare": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
