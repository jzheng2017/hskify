  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/firefox-webext-browser": "143.0.0",
    "happy-dom": "20.11.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "web-ext": "10.5.0",
    "wxt": "0.20.27"
  }
}
