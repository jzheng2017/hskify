{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["firefox-webext-browser", "vitest/globals"]
  },
  "include": [
    ".wxt/**/*.ts",
    "entrypoints/**/*.ts",
    "entrypoints/**/*.html",
    "src/**/*.ts",
    "tests/**/*.ts",
    "wxt.config.ts",
    "vitest.config.ts"
  ]
}
