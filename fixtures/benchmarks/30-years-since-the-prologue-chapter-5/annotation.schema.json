{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hskify.local/schemas/30-years-since-the-prologue-chapter-5-annotation.v1.json",
  "title": "30 Years Since the Prologue chapter 5 page annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "page", "policy", "regions"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "file", "width", "height", "sourceSha256"],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36
        },
        "file": {
          "type": "string",
          "pattern": "^[0-9]{3}\\.webp$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "detectorUse"],
      "properties": {
        "included": {
          "const": "English story text: dialogue, thoughts, narration, captions, and unbubbled spoken lines, including punctuation-only reactions and silent ellipses"
        },
        "excluded": {
          "const": "sound effects, credits, scanlation promotion, translator notes, series branding, decorative labels, ambiguous OCR, and non-English text"
        },
        "detectorUse": {
          "const": "proposal only; every region and omission was manually gated against the source image"
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "polygon": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "startChar",
        "endChar",
        "pinyin",
        "classification",
        "aboveRequestedLevel"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "startChar": {
          "type": "integer",
          "minimum": 0
        },
        "endChar": {
          "type": "integer",
          "minimum": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": ["hsk", "proper-name", "domain-term", "non-hsk", "non-lexical"]
        },
        "hskLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "aboveRequestedLevel": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "hsk"
              }
            }
          },
          "then": {
            "properties": {
              "hskLevel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              }
            },
            "required": ["hskLevel"]
          },
          "else": {
            "properties": {
              "hskLevel": false
            }
          }
        }
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "containerStyle",
        "readingOrder",
        "sourceEnglish",
        "normalizedEnglish",
        "textPolygon",
        "eraseMask",
        "geometryAudit",
        "reviewProvenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^30ysp-ch5-p[0-9]{3}-r[0-9]{2}$"
        },
        "kind": {
          "enum": ["dialogue", "thought", "narration"]
        },
        "containerStyle": {
          "enum": [
            "standard",
            "shout",
            "thought",
            "whisper",
            "reaction",
            "silent",
            "narration",
            "unbubbled"
          ]
        },
        "readingOrder": {
          "type": "integer",
          "minimum": 0
        },
        "sourceEnglish": {
          "type": "string",
          "minLength": 1
        },
        "normalizedEnglish": {
          "type": "string",
          "minLength": 1
        },
        "translationTarget": {
          "const": false,
          "description": "Present only for language-ambiguous punctuation-only regions. These remain detector, geometry, and erase-mask gold but must not emit regionReady or enter OCR, pinyin, or translation correctness gates."
        },
        "textPolygon": {
          "$ref": "#/$defs/polygon"
        },
        "bubblePolygon": {
          "$ref": "#/$defs/polygon"
        },
        "simplifiedChinese": {
          "type": "string",
          "minLength": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1
        },
        "hskTokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "hskValidation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestedLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "strictlyValid": {
              "type": "boolean"
            },
            "aboveLevelTokens": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "repairState": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "eraseMask": {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "polygon", "operation"],
          "properties": {
            "encoding": {
              "const": "normalized-polygon-v1"
            },
            "polygon": {
              "$ref": "#/$defs/polygon"
            },
            "operation": {
              "const": "erase every English glyph, outline, punctuation mark, and antialiased edge inside the polygon; preserve every pixel outside the erase mask"
            }
          }
        },
        "geometryAudit": {
          "enum": ["detector-adjusted", "manual"]
        },
        "reviewProvenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "uncertainty"],
          "properties": {
            "type": {
              "enum": ["acceptedProposal", "missedStoryTextRegion"]
            },
            "uncertainty": {
              "enum": ["low", "medium", "high"]
            },
            "proposalIndex": {
              "type": "integer",
              "minimum": 1
            },
            "missedIndex": {
              "type": "integer",
              "minimum": 1
            },
            "reviewRegionId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "productionMatch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stableRegionId", "method", "textGeometryIou"],
          "properties": {
            "stableRegionId": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "enum": [
                "stable-region-id-and-text-geometry",
                "stable-region-id-source-text-and-geometry"
              ]
            },
            "textGeometryIou": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceEnglish": {
                "type": "string",
                "pattern": "[A-Za-z\\u00c0-\\u024f\\u1e00-\\u1eff]"
              }
            },
            "required": ["sourceEnglish"]
          },
          "then": {
            "properties": {
              "translationTarget": false
            }
          },
          "else": {
            "properties": {
              "translationTarget": {
                "const": false
              }
            },
            "required": ["translationTarget"]
          }
        }
      ]
    }
  }
}
