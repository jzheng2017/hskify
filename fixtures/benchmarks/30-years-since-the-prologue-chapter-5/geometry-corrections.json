    "007.webp#1": {"sourceEnglish": "Has it been seven years since we faced each other in person,", "textBoundsPixels": [233, 1944, 666, 2250], "containerStyle": "standard", "evidence": {"type": "ppocr-v5-mobile-full", "predictionIndices": [0, 1, 2, 3, 4]}},
