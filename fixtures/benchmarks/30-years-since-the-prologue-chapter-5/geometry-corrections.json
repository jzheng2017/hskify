    "015.webp#1": {"sourceEnglish": "Four years after the Demon King's death, the Kingdom of Krasilof seemed peaceful on the surface,", "textBoundsPixels": [130, 2847, 767, 3225], "containerStyle": "narration", "evidence": {"type": "ppocr-v5-mobile-full", "predictionIndices": [6, 7, 8, 9, 10]}},
